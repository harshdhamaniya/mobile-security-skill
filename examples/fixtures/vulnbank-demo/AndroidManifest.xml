<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vulnbankdemo.app">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".VulnBankApp"
        android:allowBackup="true"
        android:debuggable="true"
        android:label="VulnBank Demo"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.TransferMoneyActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vulnbank" android:host="transfer" />
            </intent-filter>
        </activity>

        <provider
            android:name=".data.AccountProvider"
            android:authorities="com.vulnbankdemo.app.provider"
            android:exported="true" />

    </application>
</manifest>
